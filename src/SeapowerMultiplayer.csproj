<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>SeapowerMultiplayer</AssemblyName>
    <RootNamespace>SeapowerMultiplayer</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Copy output DLL to BepInEx plugins folder after build -->
    <!-- Adjust GameDir to match your Seapower install path -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Sea Power</GameDir>
  </PropertyGroup>

  <!-- BepInEx and Harmony — reference game-installed DLLs -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Game code lives in Seapower-Scripts.dll, not Assembly-CSharp.dll -->
    <Reference Include="Seapower-Scripts">
      <HintPath>$(GameDir)\Sea Power_Data\Managed\Seapower-Scripts.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)\Sea Power_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\Sea Power_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameDir)\Sea Power_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameDir)\Sea Power_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameDir)\Sea Power_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameDir)\Sea Power_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(GameDir)\Sea Power_Data\Managed\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(GameDir)\Sea Power_Data\Managed\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UniRx">
      <HintPath>$(GameDir)\Sea Power_Data\Managed\UniRx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ParadoxNotion">
      <HintPath>$(GameDir)\Sea Power_Data\Managed\ParadoxNotion.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="com.rlabrecque.steamworks.net">
      <HintPath>$(GameDir)\Sea Power_Data\Managed\com.rlabrecque.steamworks.net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The game's UI framework. Our overlay is a NoesisView on its own camera,
         so it works in every scene instead of only inside a loaded mission. -->
    <Reference Include="Noesis.NoesisGUI">
      <HintPath>$(GameDir)\Sea Power_Data\Managed\Noesis.NoesisGUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Anchor Chain chainloader (ACPlugin attribute + IAnchorChainMod).
         Checked-in copy of AnchorChain.dll from the releases dev.zip.
         NOTE: these two references are steam-branch only, so every merge from a
         BepInEx-plugin branch is liable to drop them again - that is how they
         went missing before. If AnchorChainEntry.cs stops compiling after a
         merge, this block is the first place to look. -->
    <Reference Include="AnchorChain">
      <HintPath>..\lib\AnchorChain.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- AnchorChain is built against netstandard 2.1; reference the Unity facade
         so net472 can consume it. -->
    <Reference Include="netstandard">
      <HintPath>$(GameDir)\Sea Power_Data\Managed\netstandard.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- LiteNetLib — UDP networking. Merged into our DLL by ILRepack below. -->
  <ItemGroup>
    <PackageReference Include="LiteNetLib" Version="1.3.5" />
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.34.2" PrivateAssets="all" />
  </ItemGroup>


	<PropertyGroup>
    <GameDir2>C:\Users\hughe\Desktop\Sea Power</GameDir2>
  </PropertyGroup>

  <!-- Merge LiteNetLib into our assembly.
       Anchor Chain calls GetExportedTypes() on every candidate DLL *before* any
       of our code runs, so an unresolved LiteNetLib reference throws
       ReflectionTypeLoadException at discovery and the mod is skipped entirely.
       No runtime resolver can help that (ours would not have been installed
       yet), so the reference has to not exist: ILRepack folds LiteNetLib in. -->
  <Target Name="ILRepackMerge" AfterTargets="Build">
    <ItemGroup>
      <MergeInputs Include="$(OutputPath)$(AssemblyName).dll" />
      <MergeInputs Include="$(OutputPath)LiteNetLib.dll" />
      <MergeLibDirs Include="$(OutputPath)" />
      <MergeLibDirs Include="..\lib" />
      <MergeLibDirs Include="$(GameDir)\Sea Power_Data\Managed" />
      <MergeLibDirs Include="$(GameDir)\BepInEx\core" />
    </ItemGroup>
    <ILRepack
      Parallel="true"
      Internalize="true"
      InputAssemblies="@(MergeInputs)"
      LibraryPath="@(MergeLibDirs)"
      TargetKind="Dll"
      OutputFile="$(OutputPath)merged\$(AssemblyName).dll" />
  </Target>

  <!-- Anchor Chain loads mods from a folder under StreamingAssets (or a workshop
       item dir). The merged DLL plus _info.ini (the game's own mod manifest, which
       gates the "incompatible version" prompt) are the whole workshop item. The
       build output path is deliberately NOT set to StreamingAssets, per the
       Anchor Chain docs' warning about IDEs clobbering that folder. -->
  <!-- Set SkipDeploy=true when testing the Steam Workshop copy: two installs of
       the same GUID make Anchor Chain load both and keep whichever it happens to
       see first, which may be the one you meant to disable. -->
  <Target Name="CopyToStreamingAssets" AfterTargets="ILRepackMerge" Condition="'$(SkipDeploy)' != 'true'">
    <PropertyGroup>
      <ModDir>Sea Power_Data\StreamingAssets\SeapowerMultiplayer</ModDir>
    </PropertyGroup>
    <ItemGroup>
      <ModFiles Include="$(OutputPath)merged\$(AssemblyName).dll" />
      <ModFiles Include="..\workshop\_info.ini" />
    </ItemGroup>
    <Copy SourceFiles="@(ModFiles)" DestinationFolder="$(GameDir)\$(ModDir)\" />
    <Copy SourceFiles="@(ModFiles)" DestinationFolder="$(GameDir2)\$(ModDir)\" />
    <Message Text="Copied plugin to $(GameDir)\$(ModDir)\" Importance="high" />
    <Message Text="Copied plugin to $(GameDir2)\$(ModDir)\" Importance="high" />
  </Target>

</Project>
