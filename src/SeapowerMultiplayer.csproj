<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>SeapowerMultiplayer</AssemblyName>
    <RootNamespace>SeapowerMultiplayer</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Copy output DLL to BepInEx plugins folder after build -->
    <!-- Adjust GameDir to match your Seapower install path -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Sea Power</GameDir>
  </PropertyGroup>

  <!-- BepInEx and Harmony — reference game-installed DLLs -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Game code lives in Seapower-Scripts.dll, not Assembly-CSharp.dll -->
    <Reference Include="Seapower-Scripts">
      <HintPath>$(GameDir)\Sea Power_Data\Managed\Seapower-Scripts.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)\Sea Power_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\Sea Power_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameDir)\Sea Power_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameDir)\Sea Power_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameDir)\Sea Power_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameDir)\Sea Power_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(GameDir)\Sea Power_Data\Managed\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(GameDir)\Sea Power_Data\Managed\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UniRx">
      <HintPath>$(GameDir)\Sea Power_Data\Managed\UniRx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ParadoxNotion">
      <HintPath>$(GameDir)\Sea Power_Data\Managed\ParadoxNotion.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="com.rlabrecque.steamworks.net">
      <HintPath>$(GameDir)\Sea Power_Data\Managed\com.rlabrecque.steamworks.net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The game's UI framework. Our overlay is a NoesisView on its own camera,
         so it works in every scene instead of only inside a loaded mission. -->
    <Reference Include="Noesis.NoesisGUI">
      <HintPath>$(GameDir)\Sea Power_Data\Managed\Noesis.NoesisGUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- LiteNetLib — UDP networking -->
  <ItemGroup>
    <PackageReference Include="LiteNetLib" Version="1.3.5" />
  </ItemGroup>


	<PropertyGroup>
    <GameDir2>C:\Users\hughe\Desktop\Sea Power</GameDir2>
    <!-- Third and fourth local test instances (Run Coop.bat launches all four).
         Conditioned on existing, unlike the two above: these are only present on a
         machine set up for 4-player local testing. Missing them silently is right;
         a stale DLL here is NOT silent - the protocol version is baked into the
         LiteNetLib connect key, so an out-of-date instance is rejected at connect
         and simply looks like the Connect button doing nothing. -->
    <GameDir3>C:\Users\hughe\Desktop\Sea Power Player 3</GameDir3>
    <GameDir4>C:\Users\hughe\Desktop\Sea Power Player 4</GameDir4>
  </PropertyGroup>

  <Target Name="CopyToPlugins" AfterTargets="Build">
    <!-- Copy our plugin DLL -->
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(GameDir)\BepInEx\plugins\" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(GameDir2)\BepInEx\plugins\" />
    <!-- Copy NuGet dependency DLLs (e.g. LiteNetLib) that BepInEx needs at runtime -->
    <ItemGroup>
      <PluginDeps Include="$(OutputPath)*.dll" Exclude="$(OutputPath)$(AssemblyName).dll;$(OutputPath)System.*.dll;$(OutputPath)mscorlib.dll;$(OutputPath)netstandard.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginDeps)" DestinationFolder="$(GameDir)\BepInEx\plugins\" />
    <Copy SourceFiles="@(PluginDeps)" DestinationFolder="$(GameDir2)\BepInEx\plugins\" />
    <Message Text="Copied plugin + dependencies to $(GameDir)\BepInEx\plugins\" Importance="high" />
    <Message Text="Copied plugin + dependencies to $(GameDir2)\BepInEx\plugins\" Importance="high" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll;@(PluginDeps)"
          DestinationFolder="$(GameDir3)\BepInEx\plugins\"
          Condition="Exists('$(GameDir3)\BepInEx\plugins')" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll;@(PluginDeps)"
          DestinationFolder="$(GameDir4)\BepInEx\plugins\"
          Condition="Exists('$(GameDir4)\BepInEx\plugins')" />
    <Message Text="Copied plugin + dependencies to $(GameDir3)\BepInEx\plugins\"
             Importance="high" Condition="Exists('$(GameDir3)\BepInEx\plugins')" />
    <Message Text="Copied plugin + dependencies to $(GameDir4)\BepInEx\plugins\"
             Importance="high" Condition="Exists('$(GameDir4)\BepInEx\plugins')" />
  </Target>

  <!-- Bundled scenarios. FileManager builds the mod search path from the folders
       under StreamingAssets and merges every CHECKED one's "missions" tree into a
       single list, which is what the scenario menu walks (ScenarioMenuViewModel
       .GetMissions, recursive - hence RecursiveDir). Shipping the folder is the
       whole feature; no code is involved. A subfolder becomes a group whose title
       comes from its own _info.ini.

       Deployed into StreamingAssets\user rather than a folder of our own:
       GetSearchDirectories registers every other StreamingAssets subfolder
       isActive:false, and it only turns on once ticked in the mod menu and written
       to usersettings.ini's [LoadOrder] - so a folder of our own would leave the
       missions invisible until the player found that checkbox. "user" is added
       isActive:true, isEditable:false: always on, never togglable, which matches the
       DLL loading through BepInEx regardless of mod-menu state. (The Anchor Chain
       branch ships them inside the mod folder instead, because there that folder is
       ticked by definition - the mod could not have loaded otherwise.)

       .meta files are Unity editor artifacts; the base game ships none. -->
  <Target Name="CopyMissions" AfterTargets="Build" Condition="'$(SkipDeploy)' != 'true'">
    <PropertyGroup>
      <MissionsDir>Sea Power_Data\StreamingAssets\user\missions</MissionsDir>
    </PropertyGroup>
    <ItemGroup>
      <ModMissions Include="..\missions\**\*" Exclude="..\missions\**\*.meta" />
    </ItemGroup>
    <Copy SourceFiles="@(ModMissions)" DestinationFiles="@(ModMissions->'$(GameDir)\$(MissionsDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(ModMissions)" DestinationFiles="@(ModMissions->'$(GameDir2)\$(MissionsDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Text="Copied @(ModMissions->Count()) mission file(s) to $(MissionsDir)\" Importance="high" />
  </Target>

</Project>
